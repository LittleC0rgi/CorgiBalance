<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<fx:root xmlns:fx="http://javafx.com/fxml/1"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/25"
         styleClass="pagination"
         spacing="10">

    <Label fx:id="infoLabel" styleClass="pagination__info"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="pageLabel" styleClass="pagination__info"/>
    <Button fx:id="firstButton" styleClass="pagination__btn"/>
    <Button fx:id="prevButton" text="Prev" styleClass="pagination__btn"/>
    <Button fx:id="nextButton" text="Next" styleClass="pagination__btn"/>
    <Button fx:id="lastButton" styleClass="pagination__btn"/>
    <ComboBox fx:id="pageSizeCombo" styleClass="selector"/>
</fx:root>
