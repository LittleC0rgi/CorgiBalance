<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<fx:root xmlns:fx="http://javafx.com/fxml/1"
         type="javafx.scene.control.DialogPane"
         xmlns="http://javafx.com/javafx">
    <content>
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
            </columnConstraints>
            <Label text="From account" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="fromCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="To account" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="toCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Amount" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <GridPane fx:id="rateRow" hgap="12" GridPane.columnIndex="1" GridPane.rowIndex="3"
                      managed="false" visible="false">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
                </columnConstraints>
                <Label text="Rate" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="rateField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            </GridPane>
            <Label fx:id="errorLabel" style="-fx-text-fill: #D64545;"
                   wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        </GridPane>
    </content>
</fx:root>
