<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.example.components.*?>
<fx:root xmlns:fx="http://javafx.com/fxml/1"
         type="javafx.scene.layout.VBox"
         xmlns="http://javafx.com/javafx/25"
         styleClass="sidebar"
         spacing="4">

    <HBox styleClass="brand" spacing="10">
        <StackPane styleClass="brand-icon">
            <HeroIcon icon="DATABASE"/>
        </StackPane>
        <VBox alignment="CENTER_LEFT">
            <Label text="Corgi Balance" styleClass="brand-title"/>
            <Label text="Personal Finance" styleClass="brand-subtitle"/>
        </VBox>
    </HBox>

    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>
    <ToggleButton text="Overview" toggleGroup="$navGroup" selected="true" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="HOME"/>
        </graphic>
    </ToggleButton>
    <ToggleButton text="Transactions" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="TRANSACTIONS"/>
        </graphic>
    </ToggleButton>
    <ToggleButton text="Calendar" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="CALENDAR"/>
        </graphic>
    </ToggleButton>
    <ToggleButton text="Accounts" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="WALLET"/>
        </graphic>
    </ToggleButton>
    <ToggleButton text="Budgets" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="BUDGETS"/>
        </graphic>
    </ToggleButton>
    <ToggleButton text="Analytics" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="ANALYTICS"/>
        </graphic>
    </ToggleButton>

    <Region VBox.vgrow="ALWAYS"/>

    <ToggleButton text="Settings" toggleGroup="$navGroup" styleClass="sidebar-btn">
        <graphic>
            <HeroIcon icon="SETTINGS"/>
        </graphic>
    </ToggleButton>
    <VBox styleClass="sidebar-footer">
        <Label text="v0.1.0" styleClass="version-label"/>
    </VBox>
</fx:root>
