<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<TableView xmlns:fx="http://javafx.com/fxml" fx:id="table"
           styleClass="table"
           VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx"
           fx:controller="com.corgibalance.controllers.tables.ExchangeRateTableController"
>
    <columns>
        <TableColumn fx:id="fromCurrency" text="From"/>
        <TableColumn fx:id="toCurrency" text="To"/>
        <TableColumn fx:id="rate" text="Rate"/>
        <TableColumn fx:id="rateDate" text="Date"/>
    </columns>
</TableView>
