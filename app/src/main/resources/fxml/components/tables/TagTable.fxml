<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<TableView xmlns:fx="http://javafx.com/fxml" fx:id="table"
           styleClass="table"
           VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx"
           fx:controller="com.corgibalance.controllers.tables.TagTableController"
>
    <columns>
        <TableColumn fx:id="name" text="Name"/>
        <TableColumn fx:id="color" text="Color"/>
        <TableColumn fx:id="icon" text="Icon"/>
    </columns>
</TableView>
