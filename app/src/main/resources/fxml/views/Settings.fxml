<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/25"
      fx:id="root"
      spacing="12"
      fx:controller="com.corgibalance.controllers.views.SettingsController"
>

    <Label text="Settings" styleClass="title"/>

    <VBox spacing="6" styleClass="card">
        <Label text="Database" styleClass="card__label"/>
        <Label text="Save a copy of your data or restore it from a backup." styleClass="card__text"/>
        <HBox spacing="12">
            <Button text="Connect to database" styleClass="btn, btn--primary" onAction="#connectDatabase"/>
            <Button text="Save database" styleClass="btn" onAction="#exportDatabase"/>
            <Button text="Import database" styleClass="btn" onAction="#importDatabase"/>
        </HBox>
    </VBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Tags" styleClass="card__label"/>
        <fx:include fx:id="TagTable" source="../components/tables/TagTable.fxml"/>
    </VBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Currencies" styleClass="card__label"/>
        <fx:include fx:id="CurrencyTable" source="../components/tables/CurrencyTable.fxml"/>
    </VBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Exchange rates" styleClass="card__label"/>
        <fx:include fx:id="ExchangeRateTable" source="../components/tables/ExchangeRateTable.fxml"/>
    </VBox>
</VBox>
