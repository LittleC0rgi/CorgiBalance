<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<fx:root xmlns:fx="http://javafx.com/fxml/1"
         type="javafx.scene.layout.VBox"
         xmlns="http://javafx.com/javafx/25"
         spacing="24">

    <Label text="Settings" styleClass="title"/>

    <VBox spacing="12">
        <Label text="Database"/>
        <Label text="Save a copy of your data or restore it from a backup."/>
        <HBox spacing="12">
            <Button text="Save database" styleClass="btn, btn--primary" onAction="#exportDatabase"/>
            <Button text="Import database" styleClass="btn" onAction="#importDatabase"/>
        </HBox>
    </VBox>

    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <Label text="Tags"/>
        <fx:include fx:id="TagTable" source="../components/tables/TagTable.fxml"/>
    </VBox>

    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <Label text="Currencies"/>
        <fx:include fx:id="CurrencyTable" source="../components/tables/CurrencyTable.fxml"/>
    </VBox>

    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <Label text="Exchange rates"/>
        <fx:include fx:id="ExchangeRateTable" source="../components/tables/ExchangeRateTable.fxml"/>
    </VBox>
</fx:root>
